# Build toolchain versions for the reproducible image build: BuildKit applies
# SOURCE_DATE_EPOCH only to the image configuration and not to layer
# timestamps, so the layer bytes depend on how the builder encodes them and a
# future builder could change the digests from unchanged sources.
#
# Minimum versions are enforced, while a version above the highest verified one
# is reported rather than rejected unless STRICT_TOOLCHAIN=1 turns that report
# into an error, which is what the reproducibility gate does.

# Oldest versions accepted, below which builders lack flags the canonical build
# relies on, such as --provenance.
SCITT_MIN_DOCKER_VERSION="24.0"
SCITT_MIN_BUILDX_VERSION="0.12"

# Highest versions observed to produce the canonical layers; raise these once
# the reproducibility gate has passed on a newer version.
SCITT_MAX_VERIFIED_DOCKER_VERSION="29"
SCITT_MAX_VERIFIED_BUILDX_VERSION="0.33"
