# Build toolchain versions for the reproducible image build.
#
# Layer normalization is performed by the Dockerfile itself, because BuildKit
# does not rewrite layer timestamps for SOURCE_DATE_EPOCH: it only applies that
# value to the image configuration. The layer bytes therefore depend on how the
# builder encodes them, so a future builder that changes layer encoding, tar
# entry ordering or whiteout handling could change the digests even though the
# sources are unchanged.
#
# Minimum versions are enforced. Newer versions are allowed but reported,
# because a version above the highest verified one has not been shown to
# produce the canonical layer encoding. Set STRICT_TOOLCHAIN=1 to turn that
# report into an error, which is what the reproducibility gate does.

# Oldest versions accepted. Older builders lack the flags the canonical build
# relies on, such as --provenance.
SCITT_MIN_DOCKER_VERSION="24.0"
SCITT_MIN_BUILDX_VERSION="0.12"

# Highest versions that have been observed to produce the canonical layers.
# Raise these once the reproducibility gate has passed on a newer version.
SCITT_MAX_VERIFIED_DOCKER_VERSION="29"
SCITT_MAX_VERIFIED_BUILDX_VERSION="0.33"
